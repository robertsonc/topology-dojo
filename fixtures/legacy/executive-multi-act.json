  "glossary": [
    {
      "t": "SD-WAN",
      "d": "Software-Defined WAN: intelligent overlay connecting sites over any transport."
    },
    {
      "t": "SSE",
      "d": "Security Service Edge: cloud-delivered SWG, CASB, and ZTNA."
    },
    {
      "t": "ZTNA",
      "d": "Zero Trust Network Access: identity-based, per-app access without implicit trust."
    },
    {
      "t": "CASB",
      "d": "Cloud Access Security Broker: visibility and control over SaaS usage."
    },
    {
      "t": "SWG",
      "d": "Secure Web Gateway: proxy that inspects and enforces policy on web traffic."
    }
