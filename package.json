{
  "name": "topology-dojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human-and-agent network topology diagram workspace",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "check:wrangler": "node scripts/check-wrangler-env.mjs",
    "deploy:staging": "npm run build && node scripts/check-wrangler-env.mjs && wrangler deploy --env staging",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260607.1",
    "@eslint/js": "^9.17.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "^4.20260603.0",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.14.5"
  }
}
