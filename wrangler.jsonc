{
  // Cloudflare Worker, deployed EXCLUSIVELY through the gated GitHub Actions
  // pipeline (deploy-staging.yml / deploy-production.yml — proposal 0004; the
  // legacy Workers Builds Git integration was disconnected 2026-07-17,
  // operator O9, after push-triggered `wrangler deploy` twice bypassed the
  // production approval gate).
  // Serves the built SPA (dist/) through the ASSETS binding AND exposes the MCP
  // server at /mcp, wrapped in an OAuth 2.1 provider with GitHub as the upstream
  // identity provider (see worker/index.ts). The MCP agent is a Durable Object
  // so each authoring session keeps its own in-memory topology store.
  //
  // Setup (one-time): create a GitHub OAuth App (callback
  //   https://<domain>/callback), create the OAUTH_KV namespace, and set the
  //   GITHUB_CLIENT_SECRET secret in the dashboard. Optionally set
  //   SESSION_HMAC_SECRET so browser sessions are not keyed by the OAuth
  //   client secret (falls back to GITHUB_CLIENT_SECRET when unset).
  //   See src/mcp/README.md.
  "name": "topology-dojo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Public origin used to build absolute share links from `share_topology`.
    // Set to your deployment's domain; if blank, links are site-relative.
    "PUBLIC_BASE_URL": "https://topology-dojo.harnessed.cloud",
    // GitHub OAuth App client id (public; the secret is a dashboard secret).
    "GITHUB_CLIENT_ID": "Ov23liAsmD1WV2yT4yzw",
    // Production activation (runbook Gate C / operator O11, after the O10
    // v1–v4 bootstrap deploy + green workspace_disabled smoke). Recovery for
    // any tripped stop condition is FORWARD-only: redeploy with this set back
    // to "false" — never roll back across v3 (DEPLOYMENT_RUNBOOK.md).
    "WORKSPACE_ENABLED": "true",
    // Profiles activation (proposal 0003 / migration v4): opt-in flag
    // (worker/env.ts profilesEnabled — only the literal "true" enables),
    // turned on together with the workspace flip by operator decision after
    // P4 passed staging UAT. Same forward-only recovery: redeploy with this
    // entry removed to disable the learner + profile surfaces.
    "PROFILES_ENABLED": "true",
    // Admin dashboard activation (migration v5 / runbook Gate C): opt-in flag
    // turned on after the v5 inert bootstrap deployed cleanly (run 29622343320:
    // /healthz served the new sha, /api/admin returned the inert
    // "admin_disabled" 503). Enables best-effort login recording + the
    // owner-gated /api/admin surface. Same forward-only recovery: redeploy with
    // this entry removed to disable — never roll back across v5. See
    // worker/env.ts analyticsEnabled().
    "ANALYTICS_ENABLED": "true",
    // Admin dashboard identity (migration v5): the GitHub numeric id allowed to
    // reach /api/admin. Fail-closed if unset (isAdmin returns false for
    // everyone), so the surface stays inaccessible even with ANALYTICS_ENABLED
    // on. Compared against the stable numeric id, never the mutable login. See
    // worker/env.ts isAdmin().
    "ADMIN_GITHUB_ID": "17257145",
    // Live-data / EdgeConnect fabric MCP tools (issue #228). Opt-in flag
    // (worker/env.ts liveDataEnabled — only the literal "true" enables),
    // independent of ORCH_BASE_URL / ORCH_API_KEY presence. Production stays
    // "false": do not flip this without an explicit human decision to
    // expose the connected fabric to every authenticated MCP session on
    // this deployment (optional LIVE_DATA_GITHUB_IDS can narrow that
    // grant). Secrets are dashboard-only; never commit them.
    "LIVE_DATA_ENABLED": "false",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker first for every request. It must own the auth routes
    // (/login, /logout, /auth/github, /callback), the MCP/OAuth endpoints, and
    // the share API — AND gate top-level SPA navigations behind GitHub sign-in.
    // The default handler falls through to `env.ASSETS.fetch` for static files
    // and the SPA not-found (index.html), so assets and /v/<id> shared views
    // still serve normally. An allowlist here can't express "gate every page
    // load": it let document navigations skip the gate and served /login &
    // /logout as the SPA index.html (the "sign-out does nothing" bug).
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "TopologyMcp" },
      // Per-user document registry (durable home for authored topologies,
      // independent of the ephemeral per-session MCP agent DO).
      { "name": "TOPOLOGY_REGISTRY", "class_name": "TopologyRegistry" },
      // One document coordinator per shared topology. It owns revisions,
      // proposals, scoped leases and per-page snapshots.
      { "name": "TOPOLOGY_DOCUMENT", "class_name": "TopologyDocument" },
      // Per-owner observe-only authoring profile (Packet P2 / proposal 0003-A).
      // Populated asynchronously from attributed correction outcomes; gated at
      // runtime by PROFILES_ENABLED (default off — see worker/env.ts).
      { "name": "AUTHORING_PROFILE", "class_name": "AuthoringProfile" },
      // Owner-analytics login roster for the admin dashboard (migration v5).
      // One global instance; gated at runtime by ANALYTICS_ENABLED (default
      // off — see worker/env.ts). Metadata only, never diagram content.
      { "name": "ANALYTICS", "class_name": "AnalyticsLog" },
    ],
  },
  // TOPOLOGY_KV backs `share_topology` snapshots; OAUTH_KV backs the OAuth
  // provider's grants/tokens. Create each once in the dashboard (Storage &
  // Databases → KV) and paste its id below (replace the placeholder).
  "kv_namespaces": [
    { "binding": "TOPOLOGY_KV", "id": "4a215923f07c43729f70e5f81042befe" },
    { "binding": "OAUTH_KV", "id": "b8f3af5be9e14f8da01c563f376dcc40" },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TopologyMcp"] },
    { "tag": "v2", "new_sqlite_classes": ["TopologyRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["TopologyDocument"] },
    // Packet P2: the new AuthoringProfile DO class. Append-only — never
    // reorder/rename earlier tags. It was bootstrapped inert, then activated
    // by the current top-level PROFILES_ENABLED value.
    { "tag": "v4", "new_sqlite_classes": ["AuthoringProfile"] },
    // Admin dashboard: the AnalyticsLog DO class. Append-only. It was
    // bootstrapped inert, then activated by the current top-level
    // ANALYTICS_ENABLED value. Must stay identical to staging migrations.
    { "tag": "v5", "new_sqlite_classes": ["AnalyticsLog"] },
  ],
  "observability": { "enabled": true },
  // env.staging — isolated, production-like preview surface (proposal 0004,
  // decisions 1-2: docs/proposals/0004-isolated-staging-and-deployment-pipeline.md,
  // "Wrangler configuration shape"). Wrangler does NOT inherit `vars`,
  // `kv_namespaces`, `durable_objects`, or `migrations` into named
  // environments, so every one of those keys is repeated here in full rather
  // than partially overridden — a partial override is silently wrong, not
  // rejected. `name` is set explicitly (instead of relying on Wrangler's
  // `<name>-<env>` auto-suffix) so this file is unambiguous about which
  // script — and therefore which Durable Object namespace — staging owns.
  // No staging Durable Object binding sets `script_name`, so each class gets
  // its own namespace scoped to `topology-dojo-staging`, never production's.
  // `scripts/check-wrangler-env.mjs` (run in CI and by `npm run
  // deploy:staging`) asserts staging never shares a KV id, DO script, or
  // identity value with production; see that script for the full rule list.
  "env": {
    "staging": {
      "name": "topology-dojo-staging",
      "vars": {
        // Staging origin (the staging GitHub OAuth App's callback is
        // <this>/callback). Never the production PUBLIC_BASE_URL.
        "PUBLIC_BASE_URL": "https://topology-dojo-staging.robertson-corey.workers.dev",
        // Staging-only GitHub OAuth App client id (operator checklist O3);
        // its secret is set independently via `wrangler secret put
        // GITHUB_CLIENT_SECRET --env staging` (O4). Optionally also
        // `SESSION_HMAC_SECRET --env staging` so rotating the OAuth
        // client secret does not invalidate browser sessions. Never the
        // production id.
        "GITHUB_CLIENT_ID": "Ov23liEpiupkYUA9L4vu",
        // Explicit (rather than relying on the unset-means-enabled default)
        // for clarity, per worker/env.ts `workspaceEnabled()`.
        "WORKSPACE_ENABLED": "true",
        // Staging opts INTO the observe-only authoring-profile learner so it
        // accumulates real correction data (Packet P2). Production stays unset
        // (learner off) until the operator activates — the opposite default
        // from WORKSPACE_ENABLED; see worker/env.ts `profilesEnabled()`.
        "PROFILES_ENABLED": "true",
        // Staging opts INTO owner-analytics (migration v5) so the admin
        // dashboard is live for UAT. ADMIN_GITHUB_ID is the same owner in both
        // environments (the deployment owner is the admin everywhere), so —
        // unlike PUBLIC_BASE_URL / GITHUB_CLIENT_ID — it is intentionally not
        // an isolated value.
        "ANALYTICS_ENABLED": "true",
        "ADMIN_GITHUB_ID": "17257145",
        // Live-data stays off in staging too: packet E5 (Orchestrator secret
        // provisioning) is a separate human decision, and the existing
        // live-data path is not expected on here. Flip to "true" only when
        // a non-production Orchestrator is provisioned for that env.
        // worker/env.ts liveDataEnabled() — only the literal "true" enables.
        "LIVE_DATA_ENABLED": "false",
        // Staging-only synthetic-fault gate (worker/staging-fault.ts, game-day
        // drills — docs/GAME_DAY.md). Must be exactly "staging", must exist
        // ONLY here: check-wrangler-env.mjs fails the build if any
        // DIAGNOSTICS_* key appears in the top-level (production) vars. The
        // companion DIAGNOSTICS_TOKEN is a staging-only dashboard secret
        // (`wrangler secret put DIAGNOSTICS_TOKEN --env staging`), never a var.
        "DIAGNOSTICS_ENV": "staging",
      },
      // Staging's own KV namespaces (operator checklist O2) — never the
      // production ids above.
      "kv_namespaces": [
        { "binding": "TOPOLOGY_KV", "id": "9919607c2b7941e7b258d2427da28fe4" },
        { "binding": "OAUTH_KV", "id": "9aaf419994d74908b095989110375571" },
      ],
      // Same three bindings as top-level, with no `script_name` override, so
      // each class resolves against the `topology-dojo-staging` script and
      // gets its own Durable Object namespace.
      "durable_objects": {
        "bindings": [
          { "name": "MCP_OBJECT", "class_name": "TopologyMcp" },
          { "name": "TOPOLOGY_REGISTRY", "class_name": "TopologyRegistry" },
          { "name": "TOPOLOGY_DOCUMENT", "class_name": "TopologyDocument" },
          { "name": "AUTHORING_PROFILE", "class_name": "AuthoringProfile" },
          { "name": "ANALYTICS", "class_name": "AnalyticsLog" },
        ],
      },
      // Full migration history repeated verbatim — staging must apply the
      // exact same v1-v5 sequence production does (check-wrangler-env.mjs
      // deep-equals this against the top-level array).
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TopologyMcp"] },
        { "tag": "v2", "new_sqlite_classes": ["TopologyRegistry"] },
        { "tag": "v3", "new_sqlite_classes": ["TopologyDocument"] },
        { "tag": "v4", "new_sqlite_classes": ["AuthoringProfile"] },
        { "tag": "v5", "new_sqlite_classes": ["AnalyticsLog"] },
      ],
    },
  },
}
