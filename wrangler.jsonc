{
  // Cloudflare Worker via the connected Git integration (Workers Builds).
  // Serves the built SPA (dist/) through the ASSETS binding AND exposes the MCP
  // server at /mcp (see worker/index.ts). The MCP agent is a Durable Object so
  // each authoring session keeps its own in-memory topology store.
  //
  // Dashboard build command stays `npm run build` (produces dist/); deploy is
  // the default `npx wrangler deploy`. Set the bearer secret once with:
  //   npx wrangler secret put MCP_API_KEY
  "name": "topology-dojo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  // Public origin used to build absolute share links from `share_topology`.
  // Set this to your deployment's domain (workers.dev or a custom domain). If
  // left blank, share_topology returns a site-relative "/v/<id>" path instead.
  "vars": { "PUBLIC_BASE_URL": "" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route /mcp* and the share-snapshot API to the Worker; everything else
    // (including /v/<id>) is served straight from assets, where the SPA
    // not-found handler returns index.html and the app loads the snapshot.
    "run_worker_first": ["/mcp", "/mcp/*", "/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "TopologyMcp" }],
  },
  // KV namespace backing `share_topology` snapshots. Create it once with:
  //   npx wrangler kv namespace create TOPOLOGY_KV
  // then paste the returned id below (replace the placeholder).
  "kv_namespaces": [
    { "binding": "TOPOLOGY_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TopologyMcp"] }],
  "observability": { "enabled": true },
}
